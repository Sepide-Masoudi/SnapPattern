<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="design_pattern_prototyping.controller.MetricsController">
    <top>
        <Label text="Metrics Collector" style="-fx-font-size: 18px; -fx-padding: 10 10 10 20;"/>
    </top>

    <center>
        <TabPane>
            <!-- Monitoring Setup Tab -->
            <Tab text="Monitoring Setup" closable="false">
                <VBox spacing="15.0" style="-fx-padding: 20.0;">
                    <!-- Deploy Monitoring Stack -->
                    <HBox spacing="10.0">
                        <Button fx:id="deployMetricsButton" text="Deploy Monitoring Stack" onAction="#deployMetrics"/>
                    </HBox>

                    <Label fx:id="statusLabel" style="-fx-text-fill: gray; -fx-padding: 5.0;"/>

                    <!-- Fetch Metrics Button -->
                    <VBox spacing="10.0" fx:id="metricsSetupBox">
                        <HBox spacing="10.0">
                            <Button fx:id="getMetricsButton" text="Get Metrics" onAction="#generateMetrics"/>
                            <TextField fx:id="patternTextField" promptText="Enter custom name (optional)" />
                        </HBox>
                        <HBox spacing="10.0">
                            <Button fx:id="makePlots" text="Make Plots" onAction="#makePlots"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Button fx:id="viewPlotsButton" text="View Plots" onAction="#viewPlots"/>
                        </HBox>

                        <!-- Port Forwarding Controls -->
                        <HBox spacing="10.0">
                            <Button fx:id="exportMetricsButton" text="Export Metrics Data" onAction="#exportMetrics"/>
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>
        </TabPane>

    </center>

    <bottom>
        <TitledPane text="Logs">
            <VBox style="-fx-padding: 10;">
                <TextArea fx:id="logTextArea" editable="false" wrapText="true" prefRowCount="8"/>
            </VBox>
        </TitledPane>
    </bottom>
</BorderPane>
