<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="design_pattern_prototyping.controller.WorkloadController">
    <top>
        <Label text="Workload Generator" style="-fx-font-size: 18px; -fx-padding: 10 10 10 20;"/>
    </top>

    <center>
        <VBox spacing="20.0" style="-fx-padding: 20.0;">
            <!-- Upload Workload File -->
            <HBox spacing="10.0">
                <Label text="Upload Workload File:"/>
                <Button text="Upload File" onAction="#uploadFile"/>
            </HBox>
            <!-- Select Workload File -->
            <HBox spacing="10.0">
                <Label text="Select Workload File:"/>
                <ComboBox fx:id="fileDropdown"/>
            </HBox>
            <!-- Set Frontend Hostname -->
            <HBox spacing="10.0">
                <Label text="Hostnamme (IP):"/>
                <TextField fx:id="hostnameField" text="192.168.49.2" promptText="192.168.49.2"/>
                <Label text="Port:"/>
                <TextField fx:id="portField" text="30080" promptText="30080"/>
                <Label text="Set Frontend Service:"/>
                <ComboBox fx:id="userServiceDropdown" promptText="(none selected)"/>
            </HBox>
            <!-- Set Workload level and duration -->
            <HBox spacing="10.0">
                <Label text="Select Workload Level:"/>
                <ComboBox fx:id="workloadLevelComboBox"/>
                <Button text="Configure Workload Levels" onAction="#configureWorkloadLevels"/>
            </HBox>
            <!-- Set Max Duration -->
            <HBox spacing="10.0">
                <Label text="Max Duration (minutes):"/>
                <TextField fx:id="maxDurationField" promptText="5"/>
            </HBox>
            <!-- Run workload -->
            <HBox spacing="10.0">
                <Button text="Run Workload" onAction="#runWorkload"/>
                <Button fx:id="abortButton" text="Abort" onAction="#abortWorkload" disable="true"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <TitledPane text="Logs">
            <VBox style="-fx-padding: 10;">
                <TextArea fx:id="logTextArea" editable="false" wrapText="true" prefRowCount="8"/>
            </VBox>
        </TitledPane>
    </bottom>
</BorderPane>
