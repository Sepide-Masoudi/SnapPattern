<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.design_pattern_prototyping.MetricsController">
    <top>
        <Label text="Monitoring Dashboard" style="-fx-font-size: 18px; -fx-padding: 10.0;"/>
    </top>

    <center>
        <TabPane>
            <!-- Monitoring Setup Tab -->
            <Tab text="Monitoring Setup" closable="false">
                <VBox spacing="15.0" style="-fx-padding: 20.0;">
                    <!-- Deploy Monitoring Stack -->
                    <HBox spacing="10.0">
                        <Button fx:id="deployMetricsButton" text="Deploy Monitoring Stack" onAction="#deployMetrics"/>
                    </HBox>

                    <Label fx:id="statusLabel" style="-fx-text-fill: gray; -fx-padding: 5.0;"/>

                    <!-- Fetch Metrics Button -->
                    <VBox spacing="10.0" fx:id="metricsSetupBox">
                        <HBox spacing="10.0">
                            <Button fx:id="getMetricsButton" text="Get Metrics" onAction="#generateMetrics"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Button fx:id="viewPlotsButton" text="View Plots" onAction="#viewPlots"/>
                        </HBox>

                        <!-- Port Forwarding Controls -->
                        <HBox spacing="10.0">
                            <Button fx:id="exposeServicesButton" text="Expose monitoring services" onAction="#exposeMonitoringServices"/>
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>

            <!-- Grafana Dashboard Tab -->
            <Tab text="Grafana Dashboard" closable="false">
                <VBox spacing="15.0" style="-fx-padding: 20.0;">
                    <Button fx:id="loadDashboard" text="Load Grafana Dashboard" onAction="#loadGrafanaDashboard"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
