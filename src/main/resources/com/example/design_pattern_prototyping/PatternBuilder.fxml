<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.design_pattern_prototyping.PatternBuilderController">
    <top>
        <Label text="Microservice Pattern Builder" style="-fx-font-size: 18px;"/>
    </top>

    <center>
        <VBox spacing="20.0" style="-fx-padding: 20.0;">
            <HBox spacing="10.0">
                <Button text="Start Kubernetes" onAction="#startKubernetes"/>
                <Button text="Stop Kubernetes" onAction="#stopKubernetes"/>
            </HBox>
            <!-- Step 1: Upload YAML -->
            <HBox spacing="10.0">
                <Label text="Upload YAML Configuration File" />
                <Button text="Choose File" onAction="#handleFileUpload"/>
            </HBox>
            <HBox spacing="10.0">
                <Button text="Deploy Application" onAction="#deployApplication"/>
                <Button text="Delete Application" onAction="#deleteApplication"/>
                <Button text="Delete Pattern" onAction="#deletePattern"/>
            </HBox>

            <!-- Step 2: Select Design Pattern -->
            <HBox spacing="10.0">
                <Label text="Select Design Pattern" />
                <ComboBox fx:id="patternDropdown" onAction="#handlePatternSelection">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="None"/>
                            <String fx:value="Async Request Reply"/>
                            <String fx:value="Gateway Offloading"/>
                            <String fx:value="Gateway Aggregation"/>
                            <String fx:value="Cache Aside"/>
                            <String fx:value="Circuit Breaker"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>

            <!-- Step 3: Pattern-Specific Config -->
            <VBox spacing="10.0" fx:id="patternFieldsBox" visible="false">
                <Label text="Configure Pattern" />

                <!-- StackPane to layer pattern-specific fields -->
                <StackPane>
                    <!-- Async Request Reply Config -->
                    <VBox spacing="10.0" fx:id="asyncRequestReplyFields" visible="false">
                        <Label text="Async Request Reply Configuration" style="-fx-font-weight: bold;"/>
                        <GridPane hgap="10.0" vgap="10.0">
                            <Label text="Sending Service - Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="sendingServiceName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Sending Service - Endpoint" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="sendingServiceEndpoint" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Sending Service - Port" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="sendingServicePort" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Receiving Service - Name" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="receivingServiceName" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Label text="Receiving Service - Endpoint" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="receivingServiceEndpoint" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            <Label text="Receiving Service - Port" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <TextField fx:id="receivingServicePort" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- Gateway Offloading Config -->
                    <VBox spacing="10.0" fx:id="gatewayOffloadingFields" visible="false">
                        <Label text="Gateway Offloading Configuration" style="-fx-font-weight: bold;"/>
                        <GridPane hgap="10.0" vgap="10.0">
                            <Label text="Service Host" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="serviceHost" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Service Endpoint" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="serviceEndpoint" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Service Name" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="serviceName" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- Cache Aside Config -->
                    <VBox spacing="10.0" fx:id="cacheAsideFields" visible="false">
                        <Label text="Cache Aside Configuration" style="-fx-font-weight: bold;"/>
                        <GridPane hgap="10.0" vgap="10.0">
                            <Label text="Cached Endpoints (comma-separated)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="cachedEndpoints" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Backend Service" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="backendService" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- Gateway Aggregation Config -->
                    <VBox spacing="10.0" fx:id="gatewayAggregationFields" visible="false">
                        <Label text="Gateway Aggregation Configuration" style="-fx-font-weight: bold;"/>
                        <GridPane hgap="10.0" vgap="10.0">
                            <Label text="Service - Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="ga_serviceName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Service - Endpoint" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="ga_serviceEndpoint" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Service - Host" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="ga_serviceHost" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Service - Port" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="ga_servicePort" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- Circuit Breaker Config -->
                    <VBox spacing="10.0" fx:id="circuitBreakerFields" visible="false">
                        <Label text="Circuit Breaker Configuration" style="-fx-font-weight: bold;"/>
                        <GridPane hgap="10.0" vgap="10.0">
                            <Label text="Service Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="cb_serviceName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Max pending requests" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="cb_max_pending_requests" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Max connections" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="cb_max_connections" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Failure Threshold" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="cb_failureThreshold" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Label text="Retry attempts" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="cb_retry_attempts" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        </GridPane>
                    </VBox>

                </StackPane>

                <Button text="Build Pattern" onAction="#buildPattern"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <Label fx:id="statusLabel" style="-fx-text-fill: gray; -fx-padding: 5.0;" />
    </bottom>
</BorderPane>
