<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      spacing="10" style="-fx-padding: 15;"
      fx:controller="com.example.design_pattern_prototyping.ResourceController">

    <HBox spacing="10">
        <Label text="Namespace:"/>
        <TextField fx:id="namespaceField" text="user"/>
        <CheckBox fx:id="filterNamespaceCheckbox" text="Filter by namespace"/>
        <Button text="Refresh" onAction="#loadResources"/>
    </HBox>

    <SplitPane dividerPositions="0.5">
        <VBox spacing="5">
            <Label text="Services:" style="-fx-font-weight:bold;"/>
            <ListView fx:id="serviceListView" onMouseClicked="#handleServiceSelection"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Pods:" style="-fx-font-weight:bold;"/>
            <ListView fx:id="podListView" onMouseClicked="#showPodDetails"/>
        </VBox>
    </SplitPane>

    <TitledPane text="Pod Details">
        <GridPane fx:id="podDetailsGrid" hgap="10" vgap="10" style="-fx-padding:10;">
        </GridPane>
    </TitledPane>

</VBox>