<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.5">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="PipelineLoadTest" enabled="true">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="host" elementType="Argument">
            <stringProp name="Argument.name">host</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
          </elementProp>
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port</stringProp>
            <stringProp name="Argument.value">${__P(port,8080)}</stringProp>
          </elementProp>
          <elementProp name="numUsers" elementType="Argument">
            <stringProp name="Argument.name">numUsers</stringProp>
            <stringProp name="Argument.value">${__P(numUsers,10)}</stringProp>
          </elementProp>
          <elementProp name="rampUp" elementType="Argument">
            <stringProp name="Argument.name">rampUp</stringProp>
            <stringProp name="Argument.value">${__P(rampUp,5)}</stringProp>
          </elementProp>
          <elementProp name="duration" elementType="Argument">
            <stringProp name="Argument.name">duration</stringProp>
            <stringProp name="Argument.value">${__P(duration,30)}</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.comments"></stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <!-- HTTP Defaults -->
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
        <stringProp name="HTTPSampler.domain">${host}</stringProp>
        <stringProp name="HTTPSampler.port">${port}</stringProp>
        <stringProp name="HTTPSampler.protocol">http</stringProp>
        <stringProp name="HTTPSampler.path"></stringProp>
        <stringProp name="HTTPSampler.concurrentPool">6</stringProp>
        <boolProp name="HTTPSampler.image_parser">false</boolProp>
      </ConfigTestElement>
      <hashTree/>

      <!-- Thread Group -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Users" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${numUsers}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${rampUp}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${duration}</stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <!-- Groovy Sampler -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Run Pipeline Request" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
            import groovy.json.JsonOutput

            def modes = [
                normal: [path: "pipelines/normal/", expected: [200], weight: 3],
                flaky: [path: "pipelines/flaky/", expected: [200, 500], weight: 2],
                slow: [path: "pipelines/slow/", expected: [200], weight: 3],
                broken: [path: "pipelines/block/", expected: [404, 502, 504, 500], weight: 2]
            ]

            def weightedModes = modes.collectMany { mode, cfg -&gt; [mode] * cfg.weight }
            def mode = weightedModes[new Random().nextInt(weightedModes.size())]
            def config = modes[mode]
            def fileId = 1 + new Random().nextInt(4)
            def filePath = "${config.path}book_url_pipeline_${fileId}.json"
            def payload = JsonOutput.toJson([path: filePath])

            log.info "Running mode: ${mode}, file: ${filePath}"

            def sampler = new org.apache.jmeter.protocol.http.sampler.HTTPSamplerProxy()
            sampler.setDomain(vars.get("host"))
            sampler.setPort(vars.get("port") as int)
            sampler.setProtocol("http")
            sampler.setPath("/run-pipeline-path-url")
            sampler.setMethod("POST")
            sampler.addNonEncodedArgument("", payload, "")
            sampler.setPostBodyRaw(true)

            def headerManager = new org.apache.jmeter.protocol.http.control.HeaderManager()
            headerManager.add(new org.apache.jmeter.protocol.http.control.Header("Content-Type", "application/json"))
            sampler.setHeaderManager(headerManager)

            def response = sampler.sample()
            SampleResult.setResponseData(response.responseData)
            SampleResult.setResponseCode(response.responseCode)
            SampleResult.setSuccessful(config.expected.contains(response.responseCode as Integer))
            if (!SampleResult.isSuccessful()) {
                SampleResult.setResponseMessage("Unexpected status ${response.responseCode} for mode ${mode}")
            }
          </stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>