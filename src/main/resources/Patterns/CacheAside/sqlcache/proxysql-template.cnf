datadir="/var/lib/proxysql"

admin_variables=
{
  admin_credentials="admin:admin"
  mysql_ifaces="0.0.0.0:6032"
  refresh_interval=2000
}

mysql_variables=
{
  threads=6
  max_connections=2048
  default_query_delay=0
  default_query_timeout=36000000
  have_compress=true
  poll_timeout=2000
  interfaces="0.0.0.0:3306;/tmp/proxysql.sock"
  default_schema="information_schema"
  stacksize=1048576
  server_version="5.1.30"
  connect_timeout_server=10000
  monitor_history=60000
  monitor_connect_interval=200000
  monitor_ping_interval=200000
  ping_interval_server_msec=10000
  ping_timeout_server=200
  commands_stats=true
  sessions_sort=true
  monitor_username="root"
  monitor_password="rootpassword"

  # Enable the query cache and strip comments
  mysql-query_cache_size_MB=512
  mysql-query_cache_strip_comments=true
}

mysql_servers=
(
  {
    address="teastore-db-backend.user.svc.cluster.local",
    port=3306,
    hostgroup=0,
    max_connections=100,
    monitor_user="root",
    monitor_password="rootpassword"
  }
)

mysql_users=
(
  { username = "root", password = "rootpassword", default_hostgroup = 0, active = 1 },
  { username = "root@localhost", password = "rootpassword", default_hostgroup = 0, active = 1 },
  { username = "teauser", password = "teapassword", default_hostgroup = 0, active = 1 }
)

mysql_query_rules=
(
  {
    rule_id=10
    active=1
    match_pattern="^SELECT .*"
    destination_hostgroup=0
    apply=1
    cache_ttl=30000
  },
  {
    rule_id=15
    active=1
    match_pattern="^SELECT COUNT\\(.*"
    destination_hostgroup=0
    apply=1
    cache_ttl=60000
  },
  {
  rule_id=20
  active=1
  match_pattern=".*"
  destination_hostgroup=0
  apply=0
  }
)